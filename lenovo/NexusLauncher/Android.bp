//
// Pixel Launcher (tablet) with fixes applied at build time (see
// patch_launcher.py): the swipe-home dock lands exactly on the hotseat with the
// stock 66dp grid icons, the taskbar search bar is hidden while the hotseat
// search bar widget flies into place (TaskbarQsbHider), and the transient
// taskbar no longer stays stuck open in apps (input consumer switched
// mid-touch, quick switch from home). classes.dex is edited with
// baksmali/smali from external/google-smali. The prebuilt comes from
// vendor/pixel/launcher; the patched APK is re-signed with the platform key,
// which Google app (Discover) and At a Glance accept. Listed in
// PRODUCT_SOONG_NAMESPACES in device.mk.
//

soong_namespace {
    imports: ["vendor/pixel/launcher/common"],
}

java_library {
    name: "TB710FUTaskbarQsbHiderStubs",
    srcs: ["stubs/**/*.java"],
    sdk_version: "current",
    installable: false,
}

java_library {
    name: "TB710FUTaskbarQsbHider",
    srcs: ["src/**/*.java"],
    libs: ["TB710FUTaskbarQsbHiderStubs"],
    sdk_version: "current",
    installable: false,
}

python_binary_host {
    name: "tb710fu_patch_launcher",
    main: "patch_launcher.py",
    srcs: ["patch_launcher.py"],
}

java_genrule {
    name: "NexusLauncherReleaseTablet-patched-apk",
    srcs: [
        ":NexusLauncherReleaseTablet",
        ":TB710FUTaskbarQsbHider",
    ],
    tools: [
        "android-smali",
        "d8",
        "smali-baksmali",
        "tb710fu_patch_launcher",
    ],
    out: ["NexusLauncherReleaseTablet.apk"],
    cmd: "$(location d8) --release --min-api 34 " +
        "--output $(genDir)/helper.zip $(location :TB710FUTaskbarQsbHider) && " +
        "$(location tb710fu_patch_launcher) " +
        "--baksmali $(location smali-baksmali) --smali $(location android-smali) " +
        "--helper-dex-zip $(genDir)/helper.zip " +
        "$(location :NexusLauncherReleaseTablet) $(out)",
}

android_app_import {
    name: "NexusLauncherReleaseTabletPatched",
    apk: ":NexusLauncherReleaseTablet-patched-apk",
    certificate: "platform",
    overrides: [
        "Launcher3",
        "Launcher3QuickStep",
        "TrebuchetQuickStep",
        "NexusLauncherRelease",
        "NexusLauncherReleaseTablet",
    ],
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}
