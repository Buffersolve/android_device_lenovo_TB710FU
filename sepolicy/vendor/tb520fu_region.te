# init.tb520fu.region.sh: reads the region of the running dtb, publishes it
type tb520fu_region, domain;
type tb520fu_region_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(tb520fu_region)

allow tb520fu_region vendor_shell_exec:file rx_file_perms;
allow tb520fu_region vendor_toolbox_exec:file rx_file_perms;
allow tb520fu_region vendor_sysfs_tb520fu_fdt:file r_file_perms;
set_prop(tb520fu_region, vendor_tb520fu_region_prop)

# Readable by adb shell, so users can report it
get_prop(shell, vendor_tb520fu_region_prop)
