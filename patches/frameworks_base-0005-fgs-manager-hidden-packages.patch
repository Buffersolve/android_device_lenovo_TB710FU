+<resources>
+    <!-- Packages whose foreground services are kept out of the Active apps list
+         (FgsManagerController), like services running as the system uid. Meant
+         for device services that must stay in the foreground (e.g. accessory
+         connections) but are not something the user should stop. The services
+         keep running. -->
+    <string-array name="config_fgsManagerHiddenPackages" translatable="false" />
+</resources>
