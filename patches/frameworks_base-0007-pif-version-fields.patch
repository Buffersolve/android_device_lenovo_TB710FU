-            setPropValue(fieldAndProp[0], fieldAndProp[1]);
+            final String key = fieldAndProp[0];
+            // PIF style options (spoofBuild, spoofProvider, ...) are not Build fields
+            if (key.startsWith("spoof")) {
+                continue;
+            }
+            setPropValue(buildFieldKey(key), fieldAndProp[1]);
+        }
+    }
+
+    /**
+     * The PIF JSON names Build.VERSION fields without the "VERSION." prefix
+     * (RELEASE, SECURITY_PATCH, INCREMENTAL, DEVICE_INITIAL_SDK_INT).
+     */
+    private static String buildFieldKey(String key) {
+        if (key.startsWith("VERSION.") || hasField(Build.class, key)
+                || !hasField(Build.VERSION.class, key)) {
+            return key;
+        }
+        return "VERSION." + key;
+    }
+
+    private static boolean hasField(Class<?> clazz, String name) {
+        try {
+            clazz.getDeclaredField(name);
+            return true;
+        } catch (NoSuchFieldException e) {
+            return false;
         }
