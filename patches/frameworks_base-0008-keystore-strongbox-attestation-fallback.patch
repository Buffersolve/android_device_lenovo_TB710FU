+    /**
+     * Devices whose TEE KeyMint has no attestation keys fail every attested key
+     * generation with SECURE_HW_COMMUNICATION_FAILED. When the device says so
+     * (config_keystoreAttestStrongBoxFallback), generate attested keys that
+     * did not ask for a security level in StrongBox instead.
+     */
+    private boolean canAttestInStrongBoxInstead(int securityLevel, KeyStoreException e) {
+        return securityLevel == SecurityLevel.TRUSTED_ENVIRONMENT
+                && e.getErrorCode() == KeymasterDefs.KM_ERROR_SECURE_HW_COMMUNICATION_FAILED
+                && mSpec.getAttestationChallenge() != null
+                && mAttestKeyDescriptor == null
+                && Resources.getSystem().getBoolean(R.bool.config_keystoreAttestStrongBoxFallback);
+    }
