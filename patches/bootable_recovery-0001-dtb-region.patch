       case Device::ENABLE_ADB:
         android::base::SetProperty("ro.adb.secure.recovery", "0");
         android::base::SetProperty("ctl.restart", "adbd");
@@ -895,6 +970,14 @@ Device::BuiltinAction start_recovery(Device* device, const std::vector<std::stri
     if (android::base::StartsWith(slot, "_")) slot.erase(0, 1);
     title_lines.push_back("Active slot: " + slot);
   }
+  std::string dtb_region = GetDtbRegion();
+  if (!dtb_region.empty()) {
+    title_lines.push_back("Region: " + dtb_region);
+  }
+  if (dtb_region.empty() || access(kDtbRegionTool, X_OK) != 0 ||
+      !android::base::GetBoolProperty("ro.build.ab_update", false)) {
+    device->RemoveMenuItemForAction(Device::REPAIR_DTB_REGION);
+  }
   ui->SetTitle(title_lines);
 
   ui->ResetKeyInterruptStatus();
