+// Region of the dtb (region_country, "PRC" or "ROW"), which the Lenovo
+// bootloader checks against the region of the board, and the tool that sets it
+// in the vendor_boot of a slot (device/lenovo/TB710FU/postinstall). The
+// running region is the one the bootloader accepted.
+static constexpr const char* kDtbRegionPath = "/sys/firmware/devicetree/base/region_country";
+static constexpr const char* kDtbRegionTool = "/system/bin/tb520fu_region_postinstall";
+
+static std::string GetDtbRegion() {
+  std::string region;
+  if (!android::base::ReadFileToString(kDtbRegionPath, &region)) return "";
+  // Drop the trailing NUL
+  return std::string(region.c_str());
+}
+
+// Sets the region of the dtb of the inactive slot to the running one, e.g. after
+// installing a build with the dtb of the other region there.
+static void RepairOtherSlotRegion(Device* device) {
+  RecoveryUI* ui = device->GetUI();
+  std::string slot = android::base::GetProperty("ro.boot.slot_suffix", "");
+  if (slot != "_a" && slot != "_b") {
+    ui->Print("Unknown active slot.\n");
+    return;
+  }
+  std::string other = slot == "_a" ? "b" : "a";
+  std::string region = GetDtbRegion();
+  if (region.empty()) {
+    ui->Print("Could not read the region of the board.\n");
+    return;
+  }
+  std::string question = "Set the dtb region of slot " + other + " to " + region + "?";
+  if (!yes_no(device, question.c_str(), "  The bootloader only boots the region of the board.")) {
+    return;
+  }
+
+  int pipefd[2];
+  if (pipe(pipefd) != 0) {
+    ui->Print("pipe failed: %s\n", strerror(errno));
+    return;
+  }
+  pid_t pid = fork();
+  if (pid == 0) {
+    dup2(pipefd[1], STDOUT_FILENO);
+    dup2(pipefd[1], STDERR_FILENO);
+    close(pipefd[0]);
+    close(pipefd[1]);
+    const char* slot_number = other == "a" ? "0" : "1";
+    execl(kDtbRegionTool, kDtbRegionTool, slot_number, nullptr);
+    _exit(127);
+  }
+  close(pipefd[1]);
+  if (pid < 0) {
+    close(pipefd[0]);
+    ui->Print("fork failed: %s\n", strerror(errno));
+    return;
+  }
+  std::string output;
+  android::base::ReadFdToString(pipefd[0], &output);
+  close(pipefd[0]);
+  int status;
+  waitpid(pid, &status, 0);
+  if (!output.empty()) ui->Print("%s", output.c_str());
+  if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
+    ui->Print("Slot %s has the %s dtb. To boot it: fastboot --set-active=%s\n", other.c_str(),
+              region.c_str(), other.c_str());
+  } else {
+    ui->Print("Could not set the region of slot %s.\n", other.c_str());
+  }
+}
