+
+package com.android.settings.deviceinfo;
+
+import android.content.Context;
+
+import com.android.settings.Utils;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Radio info on the About page. RadioInfo needs a phone (it crashes with
+ * "Default phones haven't been made yet!" otherwise), so hide it on devices
+ * that can neither call nor use mobile data, like SIM status.
+ */
+public class RadioInfoPreferenceController extends BasePreferenceController {
+
+    public RadioInfoPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return Utils.isMobileDataCapable(mContext) || Utils.isVoiceCapable(mContext)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
