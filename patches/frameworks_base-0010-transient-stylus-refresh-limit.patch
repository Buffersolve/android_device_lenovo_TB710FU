+    @Test
+    public void testStylusLimitIsTransientAndDisplayScoped() {
+        DisplayModeDirector director = createDirectorFromRefreshRateArray(
+                new float[]{60, 90, 120, 144}, 1, 144,
+                new int[]{DISPLAY_ID, DISPLAY_ID_2});
+        Vote userPeak = Vote.forPhysicalRefreshRates(0, 144);
+        SparseArray<Vote> votes = new SparseArray<>();
+        votes.put(Vote.PRIORITY_USER_SETTING_PEAK_REFRESH_RATE, userPeak);
+        SparseArray<SparseArray<Vote>> votesByDisplay = new SparseArray<>();
+        votesByDisplay.put(DISPLAY_ID, votes);
+        votesByDisplay.put(DISPLAY_ID_2, votes.clone());
+        director.injectVotesByDisplay(votesByDisplay);
+
+        director.setStylusRefreshRateLimit(DISPLAY_ID, 120);
+        assertThat(director.getDesiredDisplayModeSpecs(DISPLAY_ID).primary.physical.max)
+                .isEqualTo(120f);
+        assertThat(director.getDesiredDisplayModeSpecs(DISPLAY_ID_2).primary.physical.max)
+                .isEqualTo(144f);
+        assertThat(director.getVote(DISPLAY_ID, Vote.PRIORITY_USER_SETTING_PEAK_REFRESH_RATE))
+                .isSameInstanceAs(userPeak);
+
+        director.setStylusRefreshRateLimit(DISPLAY_ID, 0);
+        assertNull(director.getVote(DISPLAY_ID, Vote.PRIORITY_STYLUS));
+        assertThat(director.getDesiredDisplayModeSpecs(DISPLAY_ID).primary.physical.max)
+                .isEqualTo(144f);
+    }
+
+    @Test
+    public void testStylusLimitDoesNotRaiseUserCeiling() {
+        DisplayModeDirector director = createDirectorFromRefreshRateArray(
+                new float[]{60, 120, 144}, 1, 144);
+        SparseArray<Vote> votes = new SparseArray<>();
+        votes.put(Vote.PRIORITY_USER_SETTING_PEAK_REFRESH_RATE,
+                Vote.forPhysicalRefreshRates(0, 60));
+        SparseArray<SparseArray<Vote>> votesByDisplay = new SparseArray<>();
+        votesByDisplay.put(DISPLAY_ID, votes);
+        director.injectVotesByDisplay(votesByDisplay);
+
+        director.setStylusRefreshRateLimit(DISPLAY_ID, 120);
+        assertThat(director.getDesiredDisplayModeSpecs(DISPLAY_ID).primary.physical.max)
+                .isEqualTo(60f);
+    }
+
+    @Test
+    public void testStylusLimitOverridesHighUserMinimumButRespectsThermals() {
+        DisplayModeDirector director = createDirectorFromRefreshRateArray(
+                new float[]{60, 120, 144}, 1, 144);
+        SparseArray<Vote> votes = new SparseArray<>();
+        votes.put(Vote.PRIORITY_USER_SETTING_MIN_RENDER_FRAME_RATE,
+                Vote.forRenderFrameRates(144, Float.POSITIVE_INFINITY));
+        votes.put(Vote.PRIORITY_APP_REQUEST_BASE_MODE_REFRESH_RATE,
+                Vote.forBaseModeRefreshRate(144));
+        SparseArray<SparseArray<Vote>> votesByDisplay = new SparseArray<>();
+        votesByDisplay.put(DISPLAY_ID, votes);
+        director.injectVotesByDisplay(votesByDisplay);
+        director.setStylusRefreshRateLimit(DISPLAY_ID, 120);
+        assertThat(director.getDesiredDisplayModeSpecs(DISPLAY_ID).primary.physical.max)
+                .isEqualTo(120f);
+
+        votes.put(Vote.PRIORITY_STYLUS, director.getVote(DISPLAY_ID, Vote.PRIORITY_STYLUS));
+        votes.put(Vote.PRIORITY_SKIN_TEMPERATURE, Vote.forPhysicalRefreshRates(0, 60));
+        votesByDisplay.put(DISPLAY_ID, votes);
+        director.injectVotesByDisplay(votesByDisplay);
+        assertThat(director.getDesiredDisplayModeSpecs(DISPLAY_ID).primary.physical.max)
+                .isEqualTo(60f);
+        assertTrue(Vote.PRIORITY_STYLUS < Vote.PRIORITY_LOW_POWER_MODE_RENDER_RATE);
+        assertTrue(Vote.PRIORITY_STYLUS < Vote.PRIORITY_LAYOUT_LIMITED_REFRESH_RATE);
+        assertTrue(Vote.PRIORITY_STYLUS < Vote.PRIORITY_UDFPS);
+    }
+
+    @Test
+    public void testStylusLimitRejectsInvalidRequests() {
+        DisplayModeDirector director = createDirectorFromFpsRange(60, 144);
+        for (float limit : new float[]{-1, Float.NaN, Float.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class,
+                    () -> director.setStylusRefreshRateLimit(DISPLAY_ID, limit));
+        }
+        assertThrows(IllegalArgumentException.class,
+                () -> director.setStylusRefreshRateLimit(-1, 120));
+        assertNull(director.getVote(DISPLAY_ID, Vote.PRIORITY_STYLUS));
+    }
