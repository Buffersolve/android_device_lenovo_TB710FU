@@ -265,6 +265,15 @@ public class DisplayModeDirector {
         }
     }
 
+    /** Sets or clears a display's transient stylus ceiling without rewriting user preferences. */
+    public void setStylusRefreshRateLimit(int displayId, float maxRefreshRate) {
+        if (displayId < 0 || !Float.isFinite(maxRefreshRate) || maxRefreshRate < 0) {
+            throw new IllegalArgumentException("Invalid stylus refresh-rate limit");
+        }
+        mVotesStorage.updateVote(displayId, Vote.PRIORITY_STYLUS,
+                maxRefreshRate == 0 ? null : Vote.forPhysicalRefreshRates(0, maxRefreshRate));
+    }
+
     /**
      * Same as {@link #start(SensorManager)}, but for observers that need to be delayed even more,
      * for example until SystemUI is ready.
